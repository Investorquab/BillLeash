# BillLeash — environment (fill in where the AGENT RUNS; never commit real values)
# Node fetch must use the proxy only in the hosted dev sandbox; on your own
# machine/VPS you usually do NOT set NODE_USE_ENV_PROXY.

# --- Agent wallet (the ONE wallet registered with loops; score is tied to it) ---
# The agent's signing key. Keep it in a secrets manager; never commit it.
AGENT_PRIVATE_KEY=0x...

# --- Altana (the leash) ---
# The OWNER admin key that grants/revokes the session (can be the same wallet,
# or ideally a passkey wallet). Used only for grant/revoke, where the key lives.
ALTANA_ADMIN_KEY=0x...

# --- Textile FX ---
# Test or live API key from app.textilecredit.com -> profile -> API keys.
# Needed for firm quotes (request); preview works without it.
TEXTILE_API_KEY=

# --- Self Agent ID ---
# Exported after `self-agent register` (mainnet, real passport). Never commit.
SELF_AGENT_PRIVATE_KEY=0x...

# --- Agent Vault (card checkout) ---
AGENTVAULT_API_KEY=
SELF_AGENT_PAY_PROXY_URL=wss://proxy.agentvault.io/v1
SELF_AGENT_PAY_API_URL=https://api.agentvault.io

# --- x402 facilitator (free credits; optional for settle) ---
X402_API_KEY=
